 "driver": {
  "p28_run.sh": "#!/bin/bash\n# P28 stage A at main ff5e13c: fixtures, whole ingest, then each stage alone.\nset -u\nL=$1; R=$L/run; M=/Users/zahidaramai/Local_Sites/seis-mdio-zarr; mkdir -p $R; cd $M\nPYTHONPATH=$M .venv/bin/python - $R <<'PY'\nimport sys, hashlib\nfrom pathlib import Path\nfrom tests.fixtures.generators.poststack3d import make_poststack3d\nwant = {\"small\": \"ac6001f611319a41d45d2729844d834c10ad340d0ce8a2f94f620796927ca03a\",\n        \"large\": \"2b8b7aa0851771ae8d2981ed173de63f7dd94f0b50124d3a7bf2881b9cd3eb2e\"}\nr = Path(sys.argv[1])\nfor name, ni in ((\"small\", 150), (\"large\", 600)):\n    p = make_poststack3d(r / f\"{name}.sgy\", n_inline=ni, n_crossline=630, n_samples=1000).path\n    h = hashlib.sha256()\n    with p.open(\"rb\") as f:\n        for b in iter(lambda: f.read(1 << 24), b\"\"): h.update(b)\n    assert h.hexdigest() == want[name], (name, h.hexdigest())\n    print(\"fixture\", name, \"sha256 ok\", flush=True)\nPY\n[ $? -eq 0 ] || { echo \"FIXTURE MISMATCH, stopped\"; exit 3; }\nfor n in small large; do\n  /usr/bin/time -l .venv/bin/sdip ingest $R/$n.sgy $R/$n.mdio > $R/$n.ingest.out 2> $R/$n.ingest.time\n  echo \"whole $n exit $? $(grep 'maximum resident' $R/$n.ingest.time)\"\n  for s in baseline preflight hash g1 file_headers convert axis_origin raw_samples header_plane marker; do\n    out=$(PYTHONPATH=$M .venv/bin/python $L/p28_step.py $s $R/$n.sgy $R/$n.mdio $R/$n.convert.mdio 2>$R/$n.$s.err | tail -1)\n    echo \"$n $s $out\"\n  done\n  rm -rf $R/$n.convert.mdio\ndone\n",
  "p28_stageB.sh": "#!/bin/bash\n# P28 stage B: whole ingest, the two changed stages alone, store hashes vs stage A.\nset -u\nL=$1; R=$L/run; M=/Users/zahidaramai/Local_Sites/seis-mdio-zarr; S=$(dirname $L); cd $M\nfor n in small large; do\n  rm -rf $R/$n.mdio\n  /usr/bin/time -l .venv/bin/sdip ingest $R/$n.sgy $R/$n.mdio > $R/$n.ingestB.out 2> $R/$n.ingestB.time\n  echo \"wholeB $n exit $? $(grep 'maximum resident' $R/$n.ingestB.time)\"\n  .venv/bin/python $S/store_hashes.py $R/$n.mdio > $L/$n.stageB.hashes.json\n  cmp -s $L/$n.stageA.hashes.json $L/$n.stageB.hashes.json && echo \"hashes $n IDENTICAL\" || echo \"hashes $n DIFFER\"\n  for s in raw_samples header_plane; do\n    out=$(PYTHONPATH=$M .venv/bin/python $L/p28_step.py $s $R/$n.sgy $R/$n.mdio $R/$n.convert.mdio 2>$R/$n.$s.B.err | tail -1)\n    echo \"$n B $s $out\"\n  done\n  .venv/bin/python $S/store_hashes.py $R/$n.mdio | cmp -s - $L/$n.stageA.hashes.json && echo \"hashes-after-rewrite $n IDENTICAL\" || echo \"hashes-after-rewrite $n DIFFER\"\ndone\n",
  "p28_step.py": "\"\"\"P28 stage A: run ONE ingest stage alone and print its process's peak RSS (bytes, macOS).\"\"\"\nimport json, resource, shutil, sys\nfrom pathlib import Path\n\nif __name__ == \"__main__\":\n    stage, source, store, scratch = sys.argv[1], Path(sys.argv[2]), Path(sys.argv[3]), Path(sys.argv[4])\n    from sdip.cli.main import _declaration\n    declaration = _declaration(\"1\", \"PostStack3DTime\", None, None)\n    if stage == \"baseline\":\n        pass\n    elif stage == \"preflight\":\n        from sdip.ingest.orchestrator import validate_source; validate_source(source, declaration)\n    elif stage == \"hash\":\n        from sdip.provenance.hashing import sha256_file; sha256_file(source)\n    elif stage == \"g1\":\n        from sdip.spec.gate import g1_for_spec; g1_for_spec(declaration.build_spec())\n    elif stage == \"file_headers\":\n        from sdip.ingest.file_headers import classify_textual_header, read_raw_file_headers\n        raw = read_raw_file_headers(source)\n        classify_textual_header(raw.textual, declaration.build_spec().segy_spec.text_header)\n    elif stage == \"convert\":\n        from sdip.ingest.file_headers import file_headers_persisted\n        from mdio import segy_to_mdio\n        from mdio.builder.template_registry import get_template\n        if scratch.exists():\n            shutil.rmtree(scratch)\n        built = declaration.build_spec()\n        with file_headers_persisted():\n            segy_to_mdio(segy_spec=built.segy_spec, mdio_template=get_template(declaration.template),\n                         input_path=source, output_path=scratch, overwrite=True, grid_overrides=None)\n    elif stage == \"axis_origin\":\n        from segy import SegyFile\n        from sdip.ingest.sample_axis import decide_for_store\n        spec = declaration.build_spec().segy_spec\n        decide_for_store(store, SegyFile(str(source), spec=spec).header[:])\n    elif stage == \"raw_samples\":\n        from sdip.ingest.raw_samples import attach_raw_sample_view\n        attach_raw_sample_view(store, source, declaration.build_spec().segy_spec)\n    elif stage == \"header_plane\":\n        from sdip.ingest.header_plane import attach_header_plane\n        attach_header_plane(store, source, declaration.build_spec().segy_spec)\n    elif stage == \"marker\":\n        from segy import SegyFile\n        from sdip.ingest.provenance_marker import attach_provenance_marker\n        from sdip.ingest.sample_axis import decide_for_store\n        spec = declaration.build_spec().segy_spec\n        origin = decide_for_store(store, SegyFile(str(source), spec=spec).header[:])\n        r0 = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n        attach_provenance_marker(store, declaration=declaration, sample_axis_origin=origin.marker_block())\n    else:\n        raise SystemExit(f\"unknown stage {stage}\")\n    print(json.dumps({\"stage\": stage, \"ru_maxrss\": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}))\n",
  "store_hashes.py": "\"\"\"sha256 of every array's decoded bytes in a Zarr store, plus its attributes, block by outer index.\"\"\"\nimport hashlib, json, sys\nimport numpy as np, zarr\n\ndef walk(g, prefix=\"\"):\n    for name, node in sorted(g.members()):\n        path = f\"{prefix}{name}\"\n        if isinstance(node, zarr.Group):\n            yield from walk(node, path + \"/\")\n        else:\n            yield path, node\n\nif __name__ == \"__main__\":\n    g = zarr.open_group(sys.argv[1], mode=\"r\")\n    out = {}\n    for path, a in walk(g):\n        h = hashlib.sha256()\n        if a.ndim == 0 or a.shape[0] == 0:\n            h.update(np.asarray(a[...]).tobytes())\n        else:\n            for i in range(a.shape[0]):\n                h.update(np.ascontiguousarray(a[i]).tobytes())\n        out[path] = {\"shape\": list(a.shape), \"dtype\": str(a.dtype), \"sha256\": h.hexdigest(),\n                     \"attrs_sha256\": hashlib.sha256(json.dumps(dict(a.attrs), sort_keys=True, default=str).encode()).hexdigest()}\n    print(json.dumps(out, indent=1, sort_keys=True))\n"
 },
