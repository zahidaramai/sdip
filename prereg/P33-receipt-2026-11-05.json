 "driver": {
  "p33_run.sh": "#!/bin/bash\n# P33 stage A: fixtures (hash-checked), ingest once each, equality, then each step alone.\nset -u\nL=$1; R=$L/run; M=/Users/zahidaramai/Local_Sites/seis-mdio-zarr; S=$(dirname $L); mkdir -p $R; cd $M\ngit log --oneline -1; git status --porcelain | head -3\nPYTHONPATH=$M .venv/bin/python - $R <<'PY'\nimport sys, hashlib\nfrom pathlib import Path\nfrom tests.fixtures.generators.poststack3d import make_poststack3d\nwant = {\"small\": \"ac6001f611319a41d45d2729844d834c10ad340d0ce8a2f94f620796927ca03a\",\n        \"large\": \"2b8b7aa0851771ae8d2981ed173de63f7dd94f0b50124d3a7bf2881b9cd3eb2e\"}\nr = Path(sys.argv[1])\nfor name, ni in ((\"small\", 150), (\"large\", 600)):\n    p = make_poststack3d(r / f\"{name}.sgy\", n_inline=ni, n_crossline=630, n_samples=1000).path\n    h = hashlib.sha256()\n    with p.open(\"rb\") as f:\n        for b in iter(lambda: f.read(1 << 24), b\"\"): h.update(b)\n    assert h.hexdigest() == want[name], (name, h.hexdigest())\n    print(\"fixture\", name, \"sha256 ok\", flush=True)\nPY\n[ $? -eq 0 ] || { echo \"FIXTURE MISMATCH, stopped\"; exit 3; }\nfor n in small large; do\n  .venv/bin/sdip ingest $R/$n.sgy $R/$n.mdio > /dev/null 2>&1; echo \"ingest $n exit $?\"\n  out=$(PYTHONPATH=$M .venv/bin/python $S/p33_step.py equality $R/$n.sgy $R/$n.mdio 2>$R/$n.eq.err | tail -1); echo \"$n $out\"\n  echo \"$out\" | grep -q '\"maps_equal\": true' && ! echo \"$out\" | grep -q 'false' || { echo \"EQUALITY FAILED, stopped\"; exit 4; }\n  for s in baseline headers_whole columns_blocked map_from_whole map_from_columns axis_origin_now; do\n    out=$(PYTHONPATH=$M .venv/bin/python $S/p33_step.py $s $R/$n.sgy $R/$n.mdio 2>$R/$n.$s.err | tail -1); echo \"$n $out\"\n  done\ndone\n",
  "p33_step.py": "\"\"\"P33 stage A: run ONE step alone and print ru_maxrss (bytes, macOS). 'equality' checks first.\"\"\"\nimport json, resource, sys\nfrom pathlib import Path\nimport numpy as np\nBLOCK = 65536\nCOLS = (\"inline\", \"crossline\", \"delay_recording_time\", \"times_scalar\")\n\ndef columns_blocked(source, spec):\n    from segy import SegyFile\n    f = SegyFile(str(source), spec=spec); n = int(f.num_traces)\n    parts = {c: [] for c in COLS}\n    for i in range(0, n, BLOCK):\n        block = f.header[i:min(i + BLOCK, n)]\n        for c in COLS: parts[c].append(np.asarray(block[c]).copy())\n        del block\n    return {c: np.concatenate(v) for c, v in parts.items()}\n\ndef grid(store):\n    from sdip.equivalence.planes import _open_store, grid_coordinates, store_dimensions\n    g = _open_store(store); dims = store_dimensions(g)\n    return grid_coordinates(g, dims), dims\n\nif __name__ == \"__main__\":\n    step, source, store = sys.argv[1], Path(sys.argv[2]), Path(sys.argv[3])\n    from sdip.cli.main import _declaration\n    spec = _declaration(\"1\", \"PostStack3DTime\", None, None).build_spec().segy_spec\n    from segy import SegyFile\n    from sdip.equivalence.trace_map import build_trace_map\n    out = {\"step\": step}\n    if step == \"baseline\":\n        pass\n    elif step == \"headers_whole\":\n        h = SegyFile(str(source), spec=spec).header[:]\n    elif step == \"columns_blocked\":\n        cols = columns_blocked(source, spec)\n    elif step == \"map_from_whole\":\n        h = SegyFile(str(source), spec=spec).header[:]; coords, dims = grid(store)\n        m = build_trace_map(h, coords, dims)\n    elif step == \"map_from_columns\":\n        cols = columns_blocked(source, spec); coords, dims = grid(store)\n        m = build_trace_map(cols, coords, dims)\n    elif step == \"axis_origin_now\":\n        from sdip.ingest.sample_axis import decide_for_store\n        decide_for_store(store, SegyFile(str(source), spec=spec).header[:])\n    elif step == \"equality\":\n        h = SegyFile(str(source), spec=spec).header[:]; cols = columns_blocked(source, spec)\n        out[\"columns_equal\"] = {c: bool(np.array_equal(np.asarray(h[c]), cols[c])) for c in COLS}\n        coords, dims = grid(store)\n        a, b = build_trace_map(h, coords, dims), build_trace_map(cols, coords, dims)\n        out[\"maps_equal\"] = (a.ordinal_to_cell == b.ordinal_to_cell and a.cell_to_ordinals == b.cell_to_ordinals\n                             and a.unmapped == b.unmapped)\n        out[\"traces\"] = len(a.ordinal_to_cell)\n    else:\n        raise SystemExit(f\"unknown step {step}\")\n    out[\"ru_maxrss\"] = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n    print(json.dumps(out))\n",
  "stageB.sh": "#!/bin/bash\nset -u\nL=$1; R=$L/run; M=/Users/zahidaramai/Local_Sites/seis-mdio-zarr; S=$(dirname $L); cd $M\ngit log --oneline -1; git status --porcelain | head -3\nfor n in small large; do\n  rm -rf $R/$n.mdio\n  /usr/bin/time -l .venv/bin/sdip ingest $R/$n.sgy $R/$n.mdio > /dev/null 2> $R/$n.B.time\n  echo \"wholeB $n exit $? $(grep 'maximum resident' $R/$n.B.time)\"\n  .venv/bin/python $S/store_hashes_v2.py $R/$n.mdio > $L/$n.stageB.hashes.json\n  cmp -s $L/$n.stageA.hashes.json $L/$n.stageB.hashes.json && echo \"hashes $n IDENTICAL\" || echo \"hashes $n DIFFER\"\n  rm -rf $R/$n.mdio\ndone\nrm -f $R/small.sgy $R/large.sgy\nPYTHONPATH=$M .venv/bin/python - $R <<'PY'\nimport sys, hashlib, shutil\nfrom pathlib import Path\nfrom tests.fixtures.generators.poststack3d import make_poststack3d\nr = Path(sys.argv[1]); out = r / \"xxxl.sgy\"\nwith out.open(\"wb\") as f:\n    for k in range(18):\n        piece = make_poststack3d(r / f\"piece{k}.sgy\", n_inline=300, n_crossline=630, n_samples=1000, inline_start=100 + 300 * k).path\n        with piece.open(\"rb\") as p:\n            head = p.read(3600)\n            if k == 0: f.write(head)\n            shutil.copyfileobj(p, f, 1 << 24)\n        piece.unlink()\nh = hashlib.sha256()\nwith out.open(\"rb\") as f:\n    for b in iter(lambda: f.read(1 << 24), b\"\"): h.update(b)\nprint(\"xxxl\", out.stat().st_size, h.hexdigest(), flush=True)\nPY\n/usr/bin/time -l .venv/bin/sdip ingest $R/xxxl.sgy $R/xxxl.mdio --envelope-gib 14.0 > /dev/null 2> $R/xxxl.time\necho \"xxxl exit $? $(grep 'maximum resident' $R/xxxl.time) $(grep ' real ' $R/xxxl.time)\"\n",
  "store_hashes_v2.py": "\"\"\"sha256 of every array's decoded bytes in a Zarr store, plus its attributes, block by outer index.\"\"\"\nimport hashlib, json, sys\nimport numpy as np, zarr\n\ndef strip(attrs):\n    \"\"\"Drop statsV1.sumSquares, the one key P31 measured varying between ingests.\"\"\"\n    v = attrs.get(\"statsV1\")\n    if isinstance(v, str):\n        d = json.loads(v); d.pop(\"sumSquares\", None); attrs[\"statsV1\"] = json.dumps(d, sort_keys=True)\n    return attrs\n\ndef walk(g, prefix=\"\"):\n    for name, node in sorted(g.members()):\n        path = f\"{prefix}{name}\"\n        if isinstance(node, zarr.Group):\n            yield from walk(node, path + \"/\")\n        else:\n            yield path, node\n\nif __name__ == \"__main__\":\n    g = zarr.open_group(sys.argv[1], mode=\"r\")\n    out = {}\n    for path, a in walk(g):\n        h = hashlib.sha256()\n        if a.ndim == 0 or a.shape[0] == 0:\n            h.update(np.asarray(a[...]).tobytes())\n        else:\n            for i in range(a.shape[0]):\n                h.update(np.ascontiguousarray(a[i]).tobytes())\n        out[path] = {\"shape\": list(a.shape), \"dtype\": str(a.dtype), \"sha256\": h.hexdigest(),\n                     \"attrs_sha256\": hashlib.sha256(json.dumps(strip(dict(a.attrs)), sort_keys=True, default=str).encode()).hexdigest()}\n    print(json.dumps(out, indent=1, sort_keys=True))\n"
 },
